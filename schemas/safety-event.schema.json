{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BoxSafe Safety Event",
  "type": "object",
  "required": [
    "eventId",
    "eventType",
    "tripId",
    "serverRecordedAt",
    "hazard",
    "eventHash"
  ],
  "properties": {
    "eventId": { "type": "string" },
    "eventType": {
      "type": "string",
      "enum": [
        "WARNING_ISSUED",
        "WARNING_DISPLAYED",
        "WARNING_ACKNOWLEDGED",
        "HAZARD_BOUNDARY_ENTERED_AFTER_WARNING",
        "ROUTE_CHANGED",
        "VEHICLE_STOPPED",
        "HAZARD_CLEARED",
        "INCIDENT_REPORTED"
      ]
    },
    "tripId": { "type": "string" },
    "driverSessionId": { "type": ["string", "null"] },
    "serverRecordedAt": { "type": "string", "format": "date-time" },
    "deviceRecordedAt": { "type": ["string", "null"], "format": "date-time" },
    "location": {
      "type": ["object", "null"],
      "properties": {
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
        "accuracyMeters": { "type": ["number", "null"], "minimum": 0 }
      },
      "required": ["latitude", "longitude"]
    },
    "hazard": {
      "type": "object",
      "required": ["hazardType", "hazardId"],
      "properties": {
        "hazardType": { "type": "string" },
        "hazardId": { "type": "string" },
        "severity": { "type": ["string", "null"] },
        "source": { "type": ["string", "null"] },
        "sourceTimestamp": { "type": ["string", "null"] }
      }
    },
    "vehicleProfile": { "type": ["object", "null"] },
    "routeId": { "type": ["string", "null"] },
    "alternateRouteAvailable": { "type": ["boolean", "null"] },
    "warningDisplayed": { "type": ["boolean", "null"] },
    "driverAcknowledged": { "type": ["boolean", "null"] },
    "classification": {
      "type": ["string", "null"],
      "enum": [
        "PROCEEDED_AFTER_WARNING",
        "AVOIDED_HAZARD",
        "STOPPED_BEFORE_HAZARD",
        "UNKNOWN",
        null
      ]
    },
    "confidence": {
      "type": ["string", "null"],
      "enum": ["LOW", "MEDIUM", "HIGH", null]
    },
    "appVersion": { "type": ["string", "null"] },
    "safetyRuleVersion": { "type": ["string", "null"] },
    "previousEventHash": { "type": ["string", "null"] },
    "eventHash": { "type": "string" }
  }
}
